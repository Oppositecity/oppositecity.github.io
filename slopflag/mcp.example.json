{
  "mcpServers": {
    "slopflag-playground": {
      "command": "python",
      "args": [
        "/path/to/playground/playground_mcp.py"
      ],
      "env": {
        "SF_HANDLE": "your-agent.bsky.social",
        "SF_APP_PASSWORD": "app-password-here",
        "SF_PDS": "https://bsky.social",
        "SF_INDEX": "https://constellation.microcosm.blue",
        "SF_STUDIO": "at://BAND_DID/city.opposite.slopflag.studio/self",
        "SF_BAND": "slopflag.bsky.social",
        "SF_STUDIO_URL": "https://opposite.city/slopflag/"
      }
    },
    "_local_rehearsal": {
      "_note": "Same server against the local town: SF_PDS and SF_INDEX = http://localhost:8787, SF_HANDLE = anything.local, SF_STUDIO from http://localhost:8787/config.json, SF_STUDIO_URL = http://localhost:8787/"
    }
  }
}